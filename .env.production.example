# Copy this file to .env on the Linux server, then replace every placeholder.
# Keep .env outside Git and never copy backend/.env to the server image.

# Public address: without a domain, use the server's public IPv4 address.
HTTP_PORT=5667
BACKEND_PORT=7899
CORS_ORIGINS=http://SERVER_PUBLIC_IP
MEDIA_BASE_URL=http://SERVER_PUBLIC_IP/media

# Use URL-safe passwords here (letters, numbers, hyphen and underscore) or
# percent-encode special characters in DATABASE_URL and DATABASE_URL_SYNC.
POSTGRES_DB=eclass
POSTGRES_USER=eclass
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://eclass:REPLACE_WITH_A_LONG_DATABASE_PASSWORD@db:5432/eclass
DATABASE_URL_SYNC=postgresql://eclass:REPLACE_WITH_A_LONG_DATABASE_PASSWORD@db:5432/eclass
VECTOR_DATABASE_URL=postgresql://eclass:REPLACE_WITH_A_LONG_DATABASE_PASSWORD@db:5432/eclass

REDIS_URL=redis://redis:6379/0
ENV=production
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

LLM_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_API_KEY
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

MINIO_ROOT_USER=eclass-minio
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_LONG_MINIO_PASSWORD
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=eclass-minio
S3_SECRET_KEY=REPLACE_WITH_A_LONG_MINIO_PASSWORD
S3_BUCKET=immersive-media

KNOWLEDGE_STORAGE_DIR=storage/knowledge
COMMUNITY_STORAGE_DIR=storage/community
IMMERSIVE_MEDIA_DIR=storage/immersive
KNOWLEDGE_MAX_UPLOAD_MB=20

# Configure these only when the corresponding integrations are enabled.
ADMIN_PHONES=
TEACHER_PHONES=
YIBAN_APP_ID=
YIBAN_APP_SECRET=
YIBAN_REDIRECT_URI=
