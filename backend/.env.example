# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/sixiang
DATABASE_URL_SYNC=postgresql://postgres:postgres@127.0.0.1:5432/sixiang

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LLM API
LLM_API_KEY=your-deepseek-api-key
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Knowledge RAG. Leave VECTOR_DATABASE_URL empty to use SQLite FTS5 only.
VECTOR_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/sixiang
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
VECTOR_MAX_COSINE_DISTANCE=0.55
KNOWLEDGE_STORAGE_DIR=storage/knowledge
KNOWLEDGE_MAX_UPLOAD_MB=20
# 自主检索 Agent：模型自行决定工具调用；失败自动回退固定检索
KNOWLEDGE_AGENT_ENABLED=true
KNOWLEDGE_AGENT_TIMEOUT_SECONDS=40
# 语音合成（多模态）：缓存目录与单次合成字数上限
TTS_STORAGE_DIR=storage/tts
TTS_MAX_CHARS=500
# 图片多模态：对话可附带 data URL 图片，限制张数与 base64 长度
VISION_MAX_IMAGES=2
VISION_MAX_IMAGE_CHARS=8000000
# LLM 网关：快模型承担意图路由、查询改写、重排与引用核验；
# 连续失败触发熔断，按用户每日 token 额度限制滥用
LLM_MODEL_FAST=deepseek-v4-flash
LLM_CIRCUIT_FAIL_THRESHOLD=5
LLM_CIRCUIT_COOLDOWN_SECONDS=30
AI_DAILY_TOKEN_BUDGET=300000
# RAG 进阶：多查询改写、RRF 融合、LLM 重排、语义缓存与引用核验
RETRIEVAL_MULTI_QUERY_ENABLED=true
RETRIEVAL_MULTI_QUERY_COUNT=2
RETRIEVAL_EXPAND_TIMEOUT_SECONDS=5
# 列表重排：开启后每次问答多 1-2 秒，默认走融合顺序
RETRIEVAL_RERANK_ENABLED=false
RETRIEVAL_RERANK_TIMEOUT_SECONDS=6
# 原始查询在 RRF 融合中的权重，高于改写查询以保留用户原话的命中
RETRIEVAL_ORIGINAL_QUERY_WEIGHT=2
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.93
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_MAX_ITEMS=200
GROUNDING_CHECK_ENABLED=true
GROUNDING_TIMEOUT_SECONDS=8
COMMUNITY_STORAGE_DIR=storage/community
# Comma-separated terms that place community posts into manual review.
COMMUNITY_SENSITIVE_TERMS=
ADMIN_PHONES=
TEACHER_PHONES=

# Yiban (易班)
YIBAN_APP_ID=your-yiban-app-id
YIBAN_APP_SECRET=your-yiban-app-secret
YIBAN_REDIRECT_URI=https://your-domain.com/api/v1/auth/yiban-callback

# Server
HOST=0.0.0.0
PORT=8000
ENV=development
CORS_ORIGINS=http://127.0.0.1:5667,http://127.0.0.1:5173
